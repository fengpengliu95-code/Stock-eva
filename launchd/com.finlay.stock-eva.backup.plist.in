<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.finlay.stock-eva.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>backend.app.user.backup_cli</string>
    <string>--source</string>
    <string>__DATA_ROOT__/user/stock_eva_user.sqlite3</string>
    <string>--backup-root</string>
    <string>__BACKUP_ROOT__</string>
    <string>--keep-daily</string>
    <string>7</string>
    <string>--keep-weekly</string>
    <string>4</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__CONFIG_ROOT__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/backup.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/backup-error.log</string>
</dict>
</plist>
