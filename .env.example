# Stock EVA phase-0 development settings.
# Copy to .env for local overrides. Never commit .env.
STOCK_EVA_ENVIRONMENT=development
STOCK_EVA_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8080"]
STOCK_EVA_MARKET_DATA_DIR=var/market
STOCK_EVA_MARKET_DATABASE_NAME=stock_eva.duckdb
STOCK_EVA_USER_DATA_DIR=var/user
STOCK_EVA_USER_DATABASE_NAME=stock_eva_user.sqlite3
STOCK_EVA_PORTFOLIO_DATABASE_NAME=stock_eva_portfolio.sqlite3
# Mutable databases, locks, staging and spill stay on the local machine.
STOCK_EVA_LOCAL_CONTROL_DIR=var/control
STOCK_EVA_LOCAL_STAGING_DIR=var/staging
STOCK_EVA_LOCAL_LOCK_DIR=var/locks
STOCK_EVA_LOCAL_TEMP_DIR=var/tmp
# Optional absolute path to an already-mounted SMB market dataset.
# It is an interactive archive/source path on macOS; LaunchAgents do not read it.
# Never put SMB credentials or a network URL here. Leave unset for local mode.
# STOCK_EVA_NAS_MARKET_DATASET_ROOT=/Volumes/Stock/stock-eva-market
# Optional verified local immutable dataset. When both roots are set, this wins.
# The production installer sets it under Application Support for launchd.
# STOCK_EVA_LOCAL_MARKET_DATASET_ROOT=/Users/finlay/Library/Application Support/Stock EVA/data/market-dataset
# Optional immutable supplemental dataset. On NAS, keep it separate from bars.
# STOCK_EVA_SUPPLEMENTAL_DATA_DIR=/Volumes/Stock/stock-eva-supplemental
# GET remains read-only. Explicit init + canary + execute are required to fetch.
STOCK_EVA_AKSHARE_SUPPLEMENTAL_ENABLED=false
# Opt in only after reviewing the calendar and publication gates.
STOCK_EVA_AUTO_REFRESH_ENABLED=false
# External one-shot scheduler status; the production LaunchAgent installer sets true.
STOCK_EVA_SCHEDULED_REFRESH_ENABLED=false
# Applied before every BaoStock operation, including paginated universe reads.
STOCK_EVA_AUTO_REFRESH_MIN_REQUEST_INTERVAL_SECONDS=0.5
# Bounds each connected BaoStock socket read/write. CLI may override per run.
STOCK_EVA_BAOSTOCK_SOCKET_TIMEOUT_SECONDS=30
# R2-F3 shadow lane is isolated and default-off. These are names only; never put
# token values in this file, CLI arguments, URLs, reports or registry rows.
STOCK_EVA_PROVIDER_REGISTRY_DATABASE_NAME=provider_registry.sqlite3
STOCK_EVA_PROVIDER_SHADOW_ROOT=var/provider-shadow
STOCK_EVA_PROVIDER_SHADOW_ENABLED=false
STOCK_EVA_PROVIDER_SHADOW_EXECUTE_ENABLED=false
STOCK_EVA_PROVIDER_TICKFLOW_TOKEN_ENV_NAME=STOCK_EVA_TICKFLOW_TOKEN
STOCK_EVA_PROVIDER_TUSHARE_TOKEN_ENV_NAME=STOCK_EVA_TUSHARE_TOKEN
# STOCK_EVA_TICKFLOW_TOKEN=
# STOCK_EVA_TUSHARE_TOKEN=
